{
  "name": "moroccoapi",
  "version": "1.2.0",
  "private": true,
  "description": "A community API for reliable access to Morocco's public open data.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoroccoAPI/MoroccoAPI.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "audit": "npm audit --audit-level=high",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run audit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.5",
    "libphonenumber-js": "1.13.15"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.0.0",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
